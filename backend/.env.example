# Standard server configuration
PORT=8080
APP_ENV=development

# Admin access. ADMIN_PIN must be at least 6 digits.
# Required when APP_ENV=production; in development they default to
# 123456 / an insecure built-in secret. Generate a secret with: openssl rand -hex 32
ADMIN_PIN=
AUTH_SECRET=

# Database configuration
DATABASE_PATH=./recipes.db

# CORS configuration
# Development: use localhost. Production: set to your GitHub Pages URL.
CORS_ORIGIN=http://localhost:8080,http://localhost:8000

# Optional Cloudflare R2 image storage.
# Leave all values empty to disable image upload/delete endpoints.
# If any R2 value is set, all R2 values must be set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
