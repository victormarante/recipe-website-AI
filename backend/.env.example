# Server Configuration
PORT=8080
APP_ENV=development

# Database Configuration
DATABASE_PATH=./recipes.db

# CORS Configuration
# Development: use localhost. Production: set to your GitHub Pages URL.
CORS_ORIGIN=http://localhost:8080,http://localhost:8000

# Auth Configuration (required — no defaults)
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# JWT secret — use a long random string in production
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret

# Cloudflare R2 (image uploads — leave blank to disable image support)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
