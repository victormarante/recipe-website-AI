# Standard server configuration
PORT=8080
APP_ENV=development

# Database configuration
DATABASE_PATH=./recipes.db

# CORS configuration
# Development: use localhost. Production: set to your GitHub Pages URL.
CORS_ORIGIN=http://localhost:8080,http://localhost:8000

# Required authentication configuration
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
# Preferred for production: set AUTH_PASSWORD_HASH to a bcrypt hash and leave
# AUTH_PASSWORD empty. AUTH_PASSWORD is kept for local development and
# backwards-compatible deployments.
AUTH_PASSWORD_HASH=

# JWT secret - use a long random string in production.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret

# Optional Cloudflare R2 image storage.
# Leave all values empty to disable image upload/delete endpoints.
# If any R2 value is set, all R2 values must be set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
